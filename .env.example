# Required — set ONE of these (Anthropic is recommended)
ANTHROPIC_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here

# Uncomment and edit to override:
# AGENT_1_MODEL=llama-3.1-8b-instant
# AGENT_2_MODEL=llama-3.3-70b-versatile
# AGENT_3_MODEL=openai/gpt-oss-20b

# ──────────────────────────────────────────────────────────────
# Optional: per-agent Groq model selection
# ──────────────────────────────────────────────────────────────
# These overrides only apply when GROQ_API_KEY is set.
# When ANTHROPIC_API_KEY is set, all three agents use Claude and
# these variables are ignored.
#
# Before changing these, check the current Groq production model
# list to avoid picking a deprecated model:
#   https://console.groq.com/docs/models
#
# Defaults (used if the variable is unset):
#   AGENT_1_MODEL=llama-3.1-8b-instant
#   AGENT_2_MODEL=llama-3.3-70b-versatile
#   AGENT_3_MODEL=openai/gpt-oss-20b

